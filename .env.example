# Supabase (required — sign-in and per-user cloud sync)
# Found in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Razorpay (optional — only used by the /support contribution page)
# Dashboard → Account & Settings → API Keys.
# Use rzp_test_* keys until KYC is approved; swap to rzp_live_* to take real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard → Settings → Webhooks → Secret.
# Point the webhook at https://nexusos-sigma.vercel.app/api/support/webhook
# with the events payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
