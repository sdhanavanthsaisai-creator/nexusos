# Supabase (required — sign-in and per-user cloud sync)
# Found in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only. Used by the /api/support/* routes to write the contribution
# ledger (public.support_contributions). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (optional — only used by the /support contribution page)
# Dashboard → Account & Settings → API Keys.
# Use rzp_test_* keys until KYC is approved; swap to rzp_live_* to take real money.
# The key id is read as RAZORPAY_KEY_ID or NEXT_PUBLIC_RAZORPAY_KEY_ID.
# The key secret is read as RAZORPAY_KEY_SECRET or RAZORPAY_SECRET.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard → Settings → Webhooks → Secret.
# Point the webhook at https://nexusos-sigma.vercel.app/api/support/webhook
# with the events payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# YOUPI PG (optional - the UPI checkout on the /support page)
# A gateway you run yourself: https://github.com/youpi-pg/YouPI-PG
# Values come from its merchant admin panel.
#   YOUPI_API_URL         base origin, e.g. https://pay.yourdomain.com (no path)
#   YOUPI_MERCHANT_ID     the merchant UUID, sent as the X-Merchant-Id header
#   YOUPI_WEBHOOK_SECRET  the secret it signs webhooks with (X-Gateway-Signature)
# In the YouPI admin, point the webhook at
#   https://nexusos-sigma.vercel.app/api/support/youpi/webhook
# and subscribe to SUCCESS, FAILED, EXPIRED and CANCELLED.
# Leave these empty and the UPI option simply does not appear.
YOUPI_API_URL=https://pay.yourdomain.com
YOUPI_MERCHANT_ID=your-merchant-uuid
YOUPI_WEBHOOK_SECRET=your-youpi-webhook-secret
# Absolute origin the gateway redirects back to. Defaults to the production
# app URL; set it to http://localhost:3000 when testing locally.
# SUPPORT_RETURN_ORIGIN=http://localhost:3000
